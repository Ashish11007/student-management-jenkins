pipeline{
    agent{
        label "worker"
    }

    tools{
        maven 'mvn'
        jdk 'jdk'
        
    }
    stages{
        stage('checkout'){
            steps{
            git 'https://github.com/Ashish11007/student-management-jenkins.git'
             echo "Code Clone Successfull"
            }
        }
        stage('Check Java Version') {
    steps {
        sh '''
            echo "===== JAVA ENVIRONMENT ====="
            echo "JAVA_HOME=$JAVA_HOME"

            echo "===== JAVA ====="
            which java
            java -version

            echo "===== JAVAC ====="
            which javac
            javac -version

            echo "===== MAVEN ====="
            which mvn
            mvn -version
        '''
    }
}
        stage('Build'){
            steps{
                sh '''
                mvn clean package
                '''
             echo "build successfull"
            }
        }
        stage('Test'){
            steps{
             echo "Test Successfull"
            }
        }
        stage('Deploy'){
            steps{
              echo "Deployment successfull"
            }
        }
    }
}
