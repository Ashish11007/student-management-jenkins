pipeline{
    agent{
        label "worker"
    }

    tools{
        maven 'mvn'
        jdk 'jdk'
        
    }
    environment{
        my_aws_cred= credentials('aws-cred')
    }
    stages{
        stage('checkout'){
            steps{
            git 'https://github.com/Ashish11007/student-management-jenkins.git'
             echo "Code Clone Successfull"
            }
        }
        stage('Build'){
            steps{
                sh '''
                mvn clean package
                '''
             
            }
            post{
                success{
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }
        stage('Artifacts to s3'){
            steps{
                sh 'aws s3 cp target/*.war s3://ashish050904/Artifacts/student.war'
            }
        }
        stage('Test'){
            steps{
             echo "Test Successfull"
            }
        }
        stage('Deploy'){
            steps{
              echo "Deployment successfull"
            }
        }
    }
}